--cpu Cortex-M3
"t10\startup_stm32f103xb.o"
"t10\main.o"
"t10\stm32f1xx_it.o"
"t10\stm32f1xx_hal_msp.o"
"t10\stm32f1xx_hal_gpio_ex.o"
"t10\stm32f1xx_hal_uart.o"
"t10\stm32f1xx_hal.o"
"t10\stm32f1xx_hal_rcc.o"
"t10\stm32f1xx_hal_rcc_ex.o"
"t10\stm32f1xx_hal_gpio.o"
"t10\stm32f1xx_hal_dma.o"
"t10\stm32f1xx_hal_cortex.o"
"t10\stm32f1xx_hal_pwr.o"
"t10\stm32f1xx_hal_flash.o"
"t10\stm32f1xx_hal_flash_ex.o"
"t10\stm32f1xx_hal_exti.o"
"t10\system_stm32f1xx.o"
--strict --scatter "t10\t10.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "t10.map" -o t10\t10.axf
   1          /*The following program is made to design and implement a bare-metal Embedded C and direct memory-mapped r
             -egister access, develop a four-state LED control system. 
   2          Each valid button press advances the system to the next operating mode: running LED pattern, binary counte
             -r, alternating pattern, and all-LED flashing */
   3          
   4          #include <reg51.h>
   5          #include <stdio.h>
   6          
   7          //LED definitions
   8          sbit LED1 = P1^0;
   9          sbit LED2 = P1^2;
  10          sbit LED3 = P1^3;
  11          sbit LED4 = P1^4;
  12          
  13          //Button pins definitions
  14          sbit ROW = P2^3;   // Output
  15          sbit COL = P2^7;   // Input
  16          
  17          //defining a variable to track the mode 
  18          unsigned char mode = 0;
  19          
  20          //Variables to track the state of each mode
  21          unsigned char m1_index = 0;         //This tracks the current led position 0 1 2 3
  22          unsigned char m2_count = 0;         //This tracks the binary number at which it is in 0-15
  23          unsigned char m3_index = 0;         //This tracks which alternate it is in
  24          bit m4_toggle = 0;                  //This tracks if it is on or off
  25          
  26          //Delay
  27          void delay(){
  28   1        unsigned int i, j;
  29   1        for(i = 0; i < 100; i++)
  30   1          for(j = 0; j < 500; j++);
  31   1      }
  32          
  33          //assign the bits of the port to each LED
  34          void setLEDs(unsigned char val){
  35   1        LED1 = val & 0x01;
  36   1        LED2 = (val >> 1) & 0x01;
  37   1        LED3 = (val >> 2) & 0x01;
  38   1        LED4 = (val >> 3) & 0x01;
  39   1      }
  40          
  41          //Debouncing
  42          void checkButton(){
  43   1        ROW = 0;  
  44   1        COL = 1;   
  45   1        if (COL == 0){
  46   2          delay();          
  47   2          if (COL == 0){
  48   3            while (COL == 0){}; //Waiting for release
  49   3            mode++;
  50   3            if (mode>3) mode = 0;
  51   3          }
  52   2        }
C51 COMPILER V9.60.7.0   MAIN                                                              11/14/2026 00:07:28 PAGE 2   

  53   1      }
  54          
  55          //Mode 1 - running leds
  56          void mode1(){
  57   1        setLEDs(1 << m1_index);
  58   1        m1_index = (m1_index + 1) % 4;
  59   1      }
  60          
  61          //Mode 2 - binary counter
  62          void mode2(){
  63   1        setLEDs(m2_count);
  64   1        m2_count = (m2_count + 1) % 16;
  65   1      }
  66          
  67          //Mode 3 - alternating mode
  68          void mode3(){
  69   1        unsigned char pattern[2] = {0x0A, 0x05}; // 1010, 0101
  70   1        setLEDs(pattern[m3_index]);
  71   1        m3_index = (m3_index + 1) % 2;
  72   1      }
  73          
  74          //Mode 4 - full flash
  75          void mode4(){
  76   1        if (m4_toggle)
  77   1          setLEDs(0x0F);
  78   1        else
  79   1          setLEDs(0x00);
  80   1      
  81   1        m4_toggle = !m4_toggle;
  82   1      }
  83          
  84          //Main 
  85          void main(){
  86   1        // initially setting everything as off
  87   1        setLEDs(0x00);
  88   1      
  89   1        while(1){
  90   2          checkButton();   // ALWAYS check first
  91   2      
  92   2          switch(mode){
  93   3            case 0: mode1(); break;
  94   3            case 1: mode2(); break;
  95   3            case 2: mode3(); break;
  96   3            case 3: mode4(); break;
  97   3          }
  98   2      
  99   2          delay();   // Controls speed (non-blocking step delay)
 100   2        }
 101   1      }

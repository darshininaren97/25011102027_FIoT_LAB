  56          // Initialize LCD
  57          void lcd_init()
  58          {
  59   1          delay();
  60   1      
  61   1          lcd_send_nibble(0x20);  // 4-bit mode
  62   1      
  63   1          lcd_cmd(0x28);          // 4-bit, 2 lines, 5x8 font
  64   1          lcd_cmd(0x0C);          // Display ON, cursor OFF
  65   1          lcd_cmd(0x06);          // Increment cursor
  66   1          lcd_cmd(0x01);          // Clear display
  67   1      
  68   1          delay();
  69   1          delay();
  70   1      }
  71          
  72          // Display string
  73          void lcd_puts(char *str)
  74          {
  75   1          int i = 0;
  76   1      
  77   1          while(str[i] != '\0')
  78   1          {
  79   2              lcd_data(str[i]);
  80   2              i++;
  81   2          }
  82   1      }
  83          
  84          // Main program
  85          void main()
  86          {
  87   1          lcd_init();
